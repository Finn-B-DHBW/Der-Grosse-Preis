<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>der-grosse-preis</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.3.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- SQLite JDBC Treiber -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>
        <!-- FlatLaf modern Look and Feel -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.4</version>
        </dependency>
        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot WebSocket (STOMP + Embedded Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Jackson JSON fuer DTOs -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- ZXing QR-Code -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Plugin zum Erstellen eines ausführbaren "Fat-JAR" inkl. aller Dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- HIER deine Main-Class eintragen -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Main</mainClass>
                                </transformer>
                                <!-- Spring Boot Autoconfiguration-Dateien aus allen JARs zusammenfuehren,
                                     sonst findet Spring im Fat-JAR keine Autoconfiguration-Klassen -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.factories</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.handlers</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.schemas</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Surefire Plugin: runs unit tests (*Test.java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven Failsafe Plugin: runs integration tests (*IT.java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              ================================================================
              METRIK 4: Softwaretestmetriken – JaCoCo Code-Coverage
              ================================================================
              Gemessene Werte:
                - Line Coverage   : Anteil der Quellcode-Zeilen, die durch Tests
                                    ausgefuehrt werden.
                - Branch Coverage : Anteil der Verzweigungen (if/else, switch,
                                    ternary) die durch Tests abgedeckt sind.
                - Method Coverage : Anteil der Methoden, die mindestens einmal
                                    aufgerufen werden.
                - Class Coverage  : Anteil der Klassen mit mindestens einer
                                    getesteten Methode.

              Ausgabe: target/site/jacoco/jacoco.xml (und HTML-Report)
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <!-- Java-Agent vor den Tests einhaengen (erzeugt jacoco.exec) -->
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Coverage-Report nach verify generieren -->
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              ================================================================
              METRIK 1 + 2: Kopplung & Kohaerenz – PMD statische Analyse
              ================================================================
              Kopplung (Coupling):
                - CouplingBetweenObjects : CBO – Anzahl der Klassen, mit denen
                  eine Klasse direkt gekoppelt ist. Schwellenwert: 20.
                - ExcessiveImports       : Hohe Import-Anzahl als Kopplungs-
                  Indikator. Schwellenwert: 20 Imports.

              Kohaerenz (Cohesion):
                - GodClass              : Klassen mit WMC>=47, ATFD>5, TCC<1/3
                  haben zu viele Verantwortlichkeiten (Single Responsibility).
                - TooManyMethods        : Mehr als 20 Methoden pro Klasse.
                - TooManyFields         : Mehr als 15 Felder pro Klasse.
                - ExcessiveClassLength  : Mehr als 500 Zeilen pro Klasse.

              Regeln definiert in: pmd-metrics.xml
              Ausgabe: target/pmd.xml
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.26.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>pmd-metrics.xml</ruleset>
                    </rulesets>
                    <!-- Build soll nicht wegen Metriken fehlschlagen -->
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>false</printFailingErrors>
                    <format>xml</format>
                    <!-- Java 21 als Analyse-Ziel (kompatibel mit dem Swing-Code) -->
                    <targetJdk>21</targetJdk>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <includeTests>false</includeTests>
                </configuration>
            </plugin>

            <!--
              ================================================================
              METRIK 1 + 3: Kopplung & Klassenbeziehungen – Checkstyle
              ================================================================
              Kopplung (Coupling):
                - ClassFanOutComplexity        : Anzahl unterschiedlicher Klassen,
                  die von dieser Klasse referenziert werden (efferente Kopplung).
                  Schwellenwert: 20.
                - ClassDataAbstractionCoupling : Anzahl der in Methoden
                  instantiierten Typen. Schwellenwert: 7.

              Klassenbeziehungen:
                - MethodCount : Gesamtanzahl der Methoden pro Klasse > 20.
                  Indirekt auch Kohaerenz-Indikator.

              Regeln definiert in: checkstyle-metrics.xml
              Ausgabe: target/checkstyle-result.xml
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <configLocation>checkstyle-metrics.xml</configLocation>
                    <!-- XML-Format fuer maschinelle Auswertung -->
                    <outputFileFormat>xml</outputFileFormat>
                    <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
                    <!-- Build soll nicht wegen Metriken fehlschlagen -->
                    <failOnViolation>false</failOnViolation>
                    <failsOnError>false</failsOnError>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <consoleOutput>false</consoleOutput>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>